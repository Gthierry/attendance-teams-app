# ============================================================
# Variables d'environnement - Attendance Teams App
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env !
# ============================================================

# -------- Azure Active Directory --------
# ID du tenant Azure AD (trouvable dans Azure Portal > Azure AD > Overview)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID de l'application Azure AD enregistrée
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret de l'application Azure AD (généré dans Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# -------- Bot Teams --------
# ID de l'application du bot (Bot App ID dans Azure)
BOT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BOT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Mot de passe du bot (généré dans Azure Bot Service)
BOT_PASSWORD=your-bot-password-here

# Port du serveur bot (défaut: 3978)
BOT_PORT=3978

# -------- Base de données SQL Server --------
# Chaîne de connexion Prisma pour SQL Server
DATABASE_URL=sqlserver://localhost:1433;database=attendance;user=sa;password=YourPassword123!;trustServerCertificate=true

# -------- Backend --------
# Port du serveur backend (défaut: 3000)
PORT=3000

# URL du frontend pour CORS et Socket.io
FRONTEND_URL=http://localhost:3001

# Secret JWT pour la génération de tokens internes
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# URL du backend (utilisé par le bot)
BACKEND_URL=http://localhost:3000

# -------- Frontend --------
# URL de l'API backend
REACT_APP_API_URL=http://localhost:3000

# ID de l'application Azure AD (même que AZURE_CLIENT_ID)
REACT_APP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID du tenant Azure AD
REACT_APP_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
